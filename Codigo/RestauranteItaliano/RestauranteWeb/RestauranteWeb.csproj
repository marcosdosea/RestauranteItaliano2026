<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Mappers\**" />
    <Compile Remove="Views\NovaPasta\**" />
    <Content Remove="Mappers\**" />
    <Content Remove="Views\NovaPasta\**" />
    <EmbeddedResource Remove="Mappers\**" />
    <EmbeddedResource Remove="Views\NovaPasta\**" />
    <None Remove="Mappers\**" />
    <None Remove="Views\NovaPasta\**" />
  </ItemGroup>

  <ItemGroup>
