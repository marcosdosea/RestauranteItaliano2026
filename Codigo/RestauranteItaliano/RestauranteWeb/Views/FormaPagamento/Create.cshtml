@model RestauranteWeb.Models.FormaPagamentoViewModel

@{
    ViewData["Title"] = "Nova forma de pagamento";
}

<header class="titulo-pagina titulo-pagina--empilhado">
    <a class="link-voltar" asp-action="Index">
        <svg class="icone" aria-hidden="true"><use href="#icone-voltar"></use></svg>
        Voltar para a lista
    </a>
    <hgroup class="titulo-pagina__texto">
        <h1 class="titulo-pagina__titulo">Nova forma de pagamento<span class="u-acento">.</span></h1>
        <p class="titulo-pagina__resumo">Os campos com asterisco são obrigatórios.</p>
    </hgroup>
</header>

<form class="edicao" asp-action="Create" method="post" data-travar-envio>
    <section class="edicao__formulario" aria-label="Dados da forma de pagamento">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <p class="campo campo--serifa campo--obrigatorio">
            <label class="campo__rotulo" asp-for="Nome"></label>
            <input class="form-control" asp-for="Nome" placeholder="Ex.: Cartão de crédito" autocomplete="off" aria-describedby="Nome-ajuda">
            <small class="campo__ajuda" id="Nome-ajuda">Como aparece na hora do pagamento. Entre 3 e 50 caracteres.</small>
            <span class="campo__erro text-danger" asp-validation-for="Nome"></span>
        </p>

        <p class="grupo-botoes">
            <button class="btn btn--tinta" type="submit">
                <svg class="icone" aria-hidden="true"><use href="#icone-confirmar"></use></svg>
                Salvar forma
            </button>
            <a class="btn btn--contorno" asp-action="Index">Cancelar</a>
        </p>
    </section>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
