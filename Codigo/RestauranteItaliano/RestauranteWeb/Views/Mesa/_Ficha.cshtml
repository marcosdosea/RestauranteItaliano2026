@model RestauranteWeb.Models.MesaViewModel

<article class="ficha" aria-labelledby="ficha-nome">
    <header class="ficha__cabeca">
        <span class="ficha__grupo">@Model.NomeRestaurante</span>
        <span class="ficha__codigo">código @Model.Id</span>
    </header>
    <p class="prato">
        <span class="prato__link">
            <span class="prato__texto">
                <span class="prato__nome" id="ficha-nome">@Model.Identificacao</span>
            </span>
        </span>
    </p>
    <dl class="ficha__dados">
        <div class="ficha__dado">
            <dt class="ficha__termo">@Html.DisplayNameFor(m => m.NomeRestaurante)</dt>
            <dd class="ficha__valor">@(string.IsNullOrWhiteSpace(Model.NomeRestaurante) ? "—" : Model.NomeRestaurante)</dd>
        </div>
    </dl>
</article>
