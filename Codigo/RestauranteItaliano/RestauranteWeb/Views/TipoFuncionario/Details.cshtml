@model RestauranteWeb.Models.TipoFuncionarioViewModel

@{
    ViewData["Title"] = Model.Nome;
}

<section class="confirmacao" aria-labelledby="titulo-detalhes">

    <header class="titulo-pagina titulo-pagina--empilhado">

        <a class="link-voltar" asp-action="Index">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round"
                 aria-hidden="true">
                <path d="M19 12H5M11 6l-6 6 6 6" />
            </svg>
            Voltar para a lista
        </a>

        <hgroup class="titulo-pagina__texto">
            <p class="u-rotulo">Tipo de funcionário</p>

            <h1 class="titulo-pagina__titulo" id="titulo-detalhes">
                @Html.DisplayFor(model => model.Nome)<span class="u-acento">.</span>
            </h1>
        </hgroup>

    </header>

    <dl>
        <dt>Código</dt>
        <dd>@Html.DisplayFor(model => model.Id)</dd>

        <dt>Nome</dt>
        <dd>@Html.DisplayFor(model => model.Nome)</dd>
    </dl>

    <p class="grupo-botoes">

        <a class="btn btn--tinta" asp-action="Edit" asp-route-id="@Model.Id">
            Editar tipo
        </a>

        <a class="btn btn--contorno" asp-action="Index">
            Voltar
        </a>

        <a class="btn btn--perigo" asp-action="Delete" asp-route-id="@Model.Id">
            Excluir
        </a>

    </p>

</section>
