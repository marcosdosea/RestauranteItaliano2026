@model IEnumerable<RestauranteWeb.Models.TipoFuncionarioViewModel>

@{
    ViewData["Title"] = "Tipos de funcionários";
    var tiposFuncionario = Model.ToList();
}

<header class="titulo-pagina">
    <hgroup class="titulo-pagina__texto">
        <p class="u-rotulo">Capítulo · Configurações</p>

        <h1 class="titulo-pagina__titulo">
            Tipos de funcionários<span class="u-acento">.</span>
        </h1>

        @if (tiposFuncionario.Any())
        {
            <p class="titulo-pagina__resumo">
                @tiposFuncionario.Count
                @(tiposFuncionario.Count == 1 ? "tipo cadastrado" : "tipos cadastrados")
            </p>
        }
    </hgroup>

    <a class="btn btn--tinta" asp-action="Create">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" aria-hidden="true">
            <path d="M12 5v14M5 12h14" />
        </svg>
        Novo tipo
    </a>
</header>

@if (!tiposFuncionario.Any())
{
    <section class="vazio" aria-labelledby="vazio-titulo">
        <h2 class="vazio__titulo" id="vazio-titulo">
            Nenhum tipo de funcionário cadastrado.
        </h2>

        <p class="vazio__texto">
            Cadastre os tipos de funcionários do restaurante,
            como garçons, cozinheiros e gerentes.
        </p>

        <p class="grupo-botoes">
            <a class="btn btn--tinta" asp-action="Create">
                Cadastrar o primeiro tipo
            </a>
        </p>
    </section>
}
else
{
    <ul class="lista-simples u-lista-limpa" aria-label="Tipos de funcionários cadastrados">
        @foreach (var item in tiposFuncionario)
        {
            <li class="prato" id="tipo-@item.Id">

                <a class="prato__link" asp-action="Details" asp-route-id="@item.Id">
                    <span class="prato__texto">
                        <span class="prato__nome">
                            @Html.DisplayFor(modelItem => item.Nome)
                        </span>
                    </span>

                    <span class="u-pontos" aria-hidden="true"></span>

                    <span class="prato__codigo">
                        Código @Html.DisplayFor(modelItem => item.Id)
                    </span>
                </a>

                <ul class="prato__acoes u-lista-limpa">
                    <li>
                        <a class="prato__acao"
                           asp-action="Edit"
                           asp-route-id="@item.Id"
                           aria-label="Editar @item.Nome">
                            Editar
                        </a>
                    </li>

                    <li>
                        <a class="prato__acao prato__acao--perigo"
                           asp-action="Delete"
                           asp-route-id="@item.Id"
                           aria-label="Excluir @item.Nome">
                            Excluir
                        </a>
                    </li>
                </ul>
            </li>
        }
    </ul>
}
