@model RestauranteWeb.Models.TipoFuncionarioViewModel

@{
    ViewData["Title"] = "Novo tipo de funcionário";
}

<header class="titulo-pagina titulo-pagina--empilhado">
    <a class="link-voltar" asp-action="Index">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M11 6l-6 6 6 6" />
        </svg>
        Voltar para a lista
    </a>

    <hgroup class="titulo-pagina__texto">
        <h1 class="titulo-pagina__titulo">Novo tipo de funcionário<span class="u-acento">.</span></h1>
        <p class="titulo-pagina__resumo">Os campos com asterisco são obrigatórios.</p>
    </hgroup>
</header>

<form class="edicao" asp-action="Create" method="post" data-travar-envio>
    <section class="edicao__formulario" aria-label="Dados do tipo de funcionário">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <p class="campo campo--serifa campo--obrigatorio">
            <label class="campo__rotulo" asp-for="Nome"></label>
            <input class="form-control" asp-for="Nome" placeholder="Ex: Garçom" autocomplete="off" aria-describedby="Nome-ajuda">
            <small class="campo__ajuda" id="Nome-ajuda">Nome do tipo de funcionário. Entre 3 e 50 caracteres.</small>
            <span class="campo__erro text-danger" asp-validation-for="Nome"></span>
        </p>

        <p class="grupo-botoes">
            <button class="btn btn--tinta" type="submit">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12.5l4.5 4.5L19 7.5" />
                </svg>
                Salvar tipo
            </button>
            <a class="btn btn--contorno" asp-action="Index">Cancelar</a>
        </p>

    </section>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}