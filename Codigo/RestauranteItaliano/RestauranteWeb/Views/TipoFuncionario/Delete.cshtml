@model RestauranteWeb.Models.TipoFuncionarioViewModel

@{
    ViewData["Title"] = "Excluir tipo de funcionário";
}

<section class="confirmacao" aria-labelledby="titulo-excluir">

    <hgroup class="titulo-pagina__texto">
        <p class="u-rotulo titulo-pagina__sobretitulo--perigo">
            Excluir tipo de funcionário
        </p>

        <h1 class="titulo-pagina__titulo" id="titulo-excluir">
            Excluir este tipo de funcionário permanentemente?
        </h1>
    </hgroup>

    <div asp-validation-summary="All" class="alerta alerta--erro" role="alert"></div>

    <dl>
        <dt>Código</dt>
        <dd>@Html.DisplayFor(model => model.Id)</dd>

        <dt>Nome</dt>
        <dd>@Html.DisplayFor(model => model.Nome)</dd>
    </dl>

    <p class="alerta">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true">
            <path d="M12 4l9 16H3z" />
            <path d="M12 10v4.5M12 17.5v.5" />
        </svg>

        <span>
            <strong>Excluir não tem volta.</strong>
            O tipo de funcionário será removido da lista.
            Se ele estiver associado a algum funcionário, o sistema poderá impedir a exclusão.
        </span>
    </p>

    <form class="grupo-botoes" asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id">
        <input type="hidden" asp-for="Nome">

        <a class="btn btn--tinta btn--voltar" asp-action="Index">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round"
                 aria-hidden="true">
                <path d="M19 12H5M11 6l-6 6 6 6" />
            </svg>
            Manter o tipo
        </a>

        <button class="btn btn--perigo" type="submit">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.7"
                 stroke-linecap="round" stroke-linejoin="round"
                 aria-hidden="true">
                <path d="M4 7h16M9 7V4h6v3M6.5 7l1 13h9l1-13" />
            </svg>
            Excluir definitivamente
        </button>

        <a class="u-link-simples" asp-action="Edit" asp-route-id="@Model.Id">
            Editar em vez de excluir
        </a>
    </form>

</section>
