@model RestauranteWeb.Models.ItemCardapioModel

@{
    ViewData["Title"] = "Editar item";
}

<header class="titulo-pagina titulo-pagina--empilhado">
    <a class="link-voltar" asp-action="Index">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M11 6l-6 6 6 6" />
        </svg>
        Voltar para a lista
    </a>
    <hgroup class="titulo-pagina__texto">
        <h1 class="titulo-pagina__titulo">Editar item<span class="u-acento">.</span></h1>
        <p class="titulo-pagina__resumo">@Model.Nome</p>
    </hgroup>
</header>

<form class="edicao" asp-action="Edit" asp-route-id="@Model.Id" method="post" data-travar-envio>
    <input type="hidden" asp-for="Id">
    <section class="edicao__formulario" aria-label="Dados do item">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <partial name="_Formulario" model="Model" />

        <p class="grupo-botoes">
            <button class="btn btn--tinta" type="submit">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12.5l4.5 4.5L19 7.5" />
                </svg>
                Salvar alterações
            </button>
            <a class="btn btn--contorno" asp-action="Index">Cancelar</a>
        </p>
    </section>

    <partial name="_Previa" model="Model" />
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        await Html.RenderPartialAsync("_ScriptsDecimal");
    }
}
