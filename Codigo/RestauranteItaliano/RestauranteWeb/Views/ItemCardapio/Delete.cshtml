@model RestauranteWeb.Models.ItemCardapioViewModel

@{
    ViewData["Title"] = "Excluir item";
}

<section class="confirmacao" aria-labelledby="titulo-excluir">
    <hgroup class="titulo-pagina__texto">
        <p class="u-rotulo titulo-pagina__sobretitulo--perigo">Excluir item</p>
        <h1 class="titulo-pagina__titulo" id="titulo-excluir">Tirar este item do cardápio de vez?</h1>
    </hgroup>

    @* resumo de validação, como no padrão do professor; fica escondido enquanto não há erro *@
    <div asp-validation-summary="All" class="alerta alerta--erro" role="alert"></div>

    <partial name="_Ficha" model="Model" />

    <p class="alerta">
        <svg class="icone icone--grande" aria-hidden="true"><use href="#icone-atencao"></use></svg>
        <span>
            <strong>Excluir não tem volta.</strong> O item some da lista e do cardápio.
            Se ele já apareceu em algum pedido, o sistema não deixa excluir; nesse caso,
            edite o item e desligue “Ativo no cardápio”.
        </span>
    </p>

    <form class="grupo-botoes" asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id">
        <input type="hidden" asp-for="Nome">
        <a class="btn btn--tinta btn--voltar" asp-action="Index">
            <svg class="icone" aria-hidden="true"><use href="#icone-voltar"></use></svg>
            Manter o item
        </a>
        <button class="btn btn--perigo" type="submit">
            <svg class="icone" aria-hidden="true"><use href="#icone-lixeira"></use></svg>
            Excluir definitivamente
        </button>
        <a class="u-link-simples" asp-action="Edit" asp-route-id="@Model.Id">Editar em vez de excluir</a>
    </form>
</section>
