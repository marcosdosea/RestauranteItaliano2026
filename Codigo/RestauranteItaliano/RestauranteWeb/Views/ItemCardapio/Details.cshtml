@model RestauranteWeb.Models.ItemCardapioViewModel

@{
    ViewData["Title"] = Model.Nome;
}

<section class="confirmacao" aria-labelledby="titulo-detalhes">
    <header class="titulo-pagina titulo-pagina--empilhado">
        <a class="link-voltar" asp-action="Index">
            <svg class="icone" aria-hidden="true"><use href="#icone-voltar"></use></svg>
            Voltar para a lista
        </a>
        <h1 class="titulo-pagina__titulo" id="titulo-detalhes">@Model.Nome</h1>
    </header>

    <partial name="_Ficha" model="Model" />

    <menu class="grupo-botoes u-lista-limpa">
        <li><a class="btn btn--tinta" asp-action="Edit" asp-route-id="@Model.Id">Editar item</a></li>
        <li><a class="btn btn--contorno" asp-action="Index">Voltar</a></li>
        <li><a class="btn btn--perigo" asp-action="Delete" asp-route-id="@Model.Id">Excluir</a></li>
    </menu>
</section>
