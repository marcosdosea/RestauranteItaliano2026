@model RestauranteWeb.Models.ItemCardapioModel

@{
    ViewData["Title"] = Model.Nome;
}

<section class="confirmacao" aria-labelledby="titulo-detalhes">
    <header class="titulo-pagina titulo-pagina--empilhado">
        <a class="link-voltar" asp-action="Index">
            <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19 12H5M11 6l-6 6 6 6" />
            </svg>
            Voltar para a lista
        </a>
        <hgroup class="titulo-pagina__texto">
            <p class="u-rotulo">Item do cardápio</p>
            <h1 class="titulo-pagina__titulo" id="titulo-detalhes">@Model.Nome<span class="u-acento">.</span></h1>
        </hgroup>
    </header>

    <partial name="_Ficha" model="Model" />

    <p class="grupo-botoes">
        <a class="btn btn--tinta" asp-action="Edit" asp-route-id="@Model.Id">Editar item</a>
        <a class="btn btn--contorno" asp-action="Index">Voltar</a>
        <a class="btn btn--perigo" asp-action="Delete" asp-route-id="@Model.Id">Excluir</a>
    </p>
</section>
