@model RestauranteWeb.Models.ItemCardapioViewModel

@{
    ViewData["Title"] = "Itens do cardápio";
    var gruposCardapio = ViewData["GruposCardapio"] as SelectList;
}

@section Estilos {
    <link rel="stylesheet" href="~/lib/datatables.net/datatables.min.css">
}

<header class="titulo-pagina">
    <hgroup class="titulo-pagina__texto">
        <p class="u-rotulo">Capítulo · Cardápio</p>
        <h1 class="titulo-pagina__titulo">Itens do cardápio<span class="u-acento">.</span></h1>
        <p class="titulo-pagina__resumo" aria-live="polite" data-resumo-itens></p>
    </hgroup>
    <a class="btn btn--tinta" asp-action="Create">
        <svg class="icone" aria-hidden="true"><use href="#icone-mais"></use></svg>
        Novo item
    </a>
</header>

<search class="ferramentas">
    <label class="busca">
        <svg class="icone" aria-hidden="true"><use href="#icone-busca"></use></svg>
        <span class="visually-hidden">Buscar item pelo nome, detalhes ou grupo</span>
        <input class="busca__campo" type="search" placeholder="Buscar prato, bebida ou grupo…" autocomplete="off" data-busca-itens>
    </label>

    <label class="filtro-grupo">
        <span class="filtro-grupo__rotulo">@Html.DisplayNameFor(model => model.IdGrupoCardapio)</span>
        <select class="form-select filtro-grupo__campo" asp-items="gruposCardapio" data-grupo-itens>
            <option value="">Todos os grupos</option>
        </select>
    </label>
</search>

@* token usado pelos botões "Marcar em falta" que a tabela monta a cada página *@
@Html.AntiForgeryToken()

@* os endereços saem daqui, montados pelo ASP.NET, para o JavaScript não ter rotas escritas à mão *@
<table class="tabela-itens" id="tabela-itens"
       data-url="@Url.Action("GetDataPage")"
       data-url-detalhes="@Url.Action("Details")"
       data-url-editar="@Url.Action("Edit")"
       data-url-excluir="@Url.Action("Delete")"
       data-url-disponibilidade="@Url.Action("AlternarDisponivel")"
       data-idioma="@Url.Content("~/lib/datatables.net/pt-BR.json")">
    <caption class="visually-hidden">Itens do cardápio, com busca, filtro por grupo, ordenação e paginação</caption>
    <thead>
        <tr>
            <th scope="col">@Html.DisplayNameFor(model => model.Nome)</th>
            <th scope="col">@Html.DisplayNameFor(model => model.NomeGrupoCardapio)</th>
            <th scope="col">@Html.DisplayNameFor(model => model.Preco)</th>
            <th scope="col">Situação</th>
            <th scope="col"><span class="visually-hidden">Ações</span></th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

@section Scripts {
    <script src="~/lib/datatables.net/datatables.min.js"></script>
    <script src="~/js/itens-cardapio.js" asp-append-version="true"></script>
}
