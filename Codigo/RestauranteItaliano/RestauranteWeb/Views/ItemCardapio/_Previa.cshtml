@model RestauranteWeb.Models.ItemCardapioViewModel

@* Prévia do item como ele aparece no cardápio; o js/site.js atualiza enquanto o usuário digita
   e troca a gravura quando o grupo muda (palavras-chave do Models/Gravuras.cs) *@
<aside class="previa" aria-labelledby="previa-titulo" data-previa data-inclinar data-pasta-gravuras="@Url.Content(Gravuras.Pasta)" data-gravuras="@Gravuras.PalavrasChaveJson">
    <h2 class="previa__titulo" id="previa-titulo">Como vai aparecer</h2>
    <p class="previa__grupo">
        <img class="previa__gravura" src="@Url.Content(Gravuras.CaminhoDoGrupo(Model.NomeGrupoCardapio))" alt="" data-previa-gravura>
        <span data-previa-grupo>@(Model.NomeGrupoCardapio ?? "Grupo")</span>
    </p>
    <p class="prato" data-previa-item>
        <span class="prato__link">
            <span class="prato__texto">
                <span class="prato__nome" data-previa-nome>@(string.IsNullOrWhiteSpace(Model.Nome) ? "Nome do item" : Model.Nome)</span>
                <span class="prato__detalhe" data-previa-detalhes>@(string.IsNullOrWhiteSpace(Model.Detalhes) ? "detalhes do item" : Model.Detalhes)</span>
            </span>
            <span class="u-pontos" aria-hidden="true"></span>
            <span class="prato__selo" data-previa-selo hidden>Em falta</span>
            <span class="prato__preco" data-previa-preco>R$ —</span>
        </span>
    </p>
    <p class="previa__nota" aria-live="polite" data-previa-nota>É assim que o item aparece na lista e no cardápio.</p>
</aside>
