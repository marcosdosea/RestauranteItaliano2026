@model RestauranteWeb.Models.ItemCardapioViewModel

@{
    var emFalta = Model.Ativo && !Model.Disponivel;
}

<article class="ficha" aria-labelledby="ficha-nome" data-inclinar>
    <header class="ficha__cabeca">
        <span class="ficha__grupo"><img class="ficha__gravura" src="@Url.Content(Gravuras.CaminhoDoGrupo(Model.NomeGrupoCardapio))" alt="">@Model.NomeGrupoCardapio</span>
        <span class="ficha__codigo">código @Model.Id</span>
    </header>
    @* a linha do cardápio: nome e detalhes (título e subtítulo), os pontinhos e o preço *@
    <div class="prato @(emFalta ? "prato--em-falta" : (!Model.Ativo ? "prato--inativo" : null))">
        <hgroup class="prato__texto">
            <h2 class="prato__nome" id="ficha-nome">@Model.Nome</h2>
            @if (!string.IsNullOrWhiteSpace(Model.Detalhes))
            {
                <p class="prato__detalhe">@Model.Detalhes</p>
            }
        </hgroup>
        <span class="u-pontos" aria-hidden="true"></span>
        @if (Model.Preco.HasValue)
        {
            @* <data>: o preço formatado para quem lê e o número puro no value *@
            <data class="prato__preco" value="@Model.Preco.Value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">@Html.DisplayFor(m => m.Preco)</data>
        }
        else
        {
            <span class="prato__preco">—</span>
        }
    </div>
    <dl class="ficha__dados">
        <div class="ficha__dado">
            <dt class="ficha__termo">@Html.DisplayNameFor(m => m.NomeRestaurante)</dt>
            <dd class="ficha__valor">@Model.NomeRestaurante</dd>
        </div>
        <div class="ficha__dado">
            <dt class="ficha__termo">@Html.DisplayNameFor(m => m.Ativo)</dt>
            <dd class="ficha__valor">@(Model.Ativo ? "Sim" : "Não")</dd>
        </div>
        <div class="ficha__dado">
            <dt class="ficha__termo">@Html.DisplayNameFor(m => m.Disponivel)</dt>
            <dd class="ficha__valor">@(Model.Disponivel ? "Sim" : "Não, em falta")</dd>
        </div>
    </dl>
</article>
