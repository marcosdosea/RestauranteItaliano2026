@model RestauranteWeb.Models.FuncionarioViewModel

@{
    ViewData["Title"] = "Deletar Funcionário";
}

<h1>Deletar Funcionário</h1>

<h3>Tem certeza de que deseja deletar este funcionário?</h3>

<hr />

<div>
    <dl class="row">

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Id)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Nome)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Nome)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Cpf)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Cpf)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.NomeTipoFuncionario)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.NomeTipoFuncionario)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.NomeRestaurante)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.NomeRestaurante)
        </dd>

    </dl>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />

        <input type="submit" value="Deletar" class="btn btn-danger" />

        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
    </form>
</div>
