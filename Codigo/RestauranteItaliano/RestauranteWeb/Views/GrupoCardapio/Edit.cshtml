@model RestauranteWeb.Models.GrupoCardapioModel

@{
    ViewData["Title"] = "Editar grupo do cardápio";
}

<header class="titulo-pagina titulo-pagina--empilhado">
    <a class="link-voltar" asp-action="Index">
        <svg class="icone" aria-hidden="true"><use href="#icone-voltar"></use></svg>
        Voltar para a lista
    </a>
    <hgroup class="titulo-pagina__texto">
        <h1 class="titulo-pagina__titulo">Editar grupo do cardápio</h1>
        <p class="titulo-pagina__resumo">@Html.DisplayFor(model => model.Nome)</p>
    </hgroup>
</header>

<form class="edicao" asp-action="Edit" asp-route-id="@Model.Id" method="post" data-travar-envio>
    <input type="hidden" asp-for="Id">
    <fieldset class="edicao__formulario">
        <legend class="visually-hidden">Dados do grupo do cardápio</legend>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <p class="campo campo--serifa campo--obrigatorio">
            <span class="campo__cabeca">
                <label class="campo__rotulo" asp-for="Nome"></label>
                <span class="campo__contador" data-contador></span>
            </span>
            <input class="form-control" asp-for="Nome" maxlength="50" placeholder="Ex.: Massas" autocomplete="off" aria-describedby="Nome-ajuda">
            <small class="campo__ajuda" id="Nome-ajuda">Nome que separa os itens no cardápio, como Entradas ou Sobremesas. Entre 3 e 50 caracteres.</small>
            <span class="campo__erro text-danger" asp-validation-for="Nome"></span>
        </p>

        <menu class="grupo-botoes u-lista-limpa">
            <li>
                <button class="btn btn--tinta" type="submit">
                    <svg class="icone" aria-hidden="true"><use href="#icone-confirmar"></use></svg>
                    Salvar alterações
                </button>
            </li>
            <li><a class="btn btn--contorno" asp-action="Index">Cancelar</a></li>
        </menu>
    </fieldset>

    <aside class="previa previa--objeto" aria-labelledby="previa-titulo" data-previa-cadastro data-pasta-gravuras="@Url.Content(Gravuras.Pasta)" data-gravuras="@Gravuras.PalavrasChaveJson">
        <h2 class="previa__titulo" id="previa-titulo">Como vai aparecer</h2>
        <div class="folha folha--destaque" data-inclinar>
            <p class="folha__capitulo">@(Model?.Id > 0 ? "folha do cardápio" : "nova folha")</p>
            <img class="folha__gravura" src="@Url.Content(Gravuras.CaminhoDoGrupo(Model?.Nome))" alt="" data-previa-gravura>
            <p class="folha__nome"><span data-previa-nome data-previa-vazio="Nome do grupo">@(string.IsNullOrWhiteSpace(Model?.Nome) ? "Nome do grupo" : Model.Nome)</span></p>
            <p class="folha__codigo">@(Model?.Id > 0 ? $"Código {Model.Id}" : "Código novo")</p>
        </div>
        <p class="previa__nota">A gravura acompanha o nome: entradas, massas, pizzas, carnes, sobremesas e bebidas têm a sua; os outros grupos usam a gravura do prato.</p>
    </aside>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
