@model RestauranteWeb.Models.TipoRestauranteModel

@{
    ViewData["Title"] = "Excluir Tipo de Restaurante";
}

<h1>Excluir Tipo de Restaurante</h1>

<h3>Tem certeza que deseja excluir este tipo de restaurante?</h3>
<div>

    <div asp-validation-summary="All" class="text-danger">></div>

    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Id)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Id)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Nome)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Nome)</dd>
    </dl>
    <form asp-action="Delete" asp-route-id="@Model.Id">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Nome" />
        <button type="submit" class="btn btn-excluir">Excluir</button>
        <a asp-action="Index" class="btn btn-secundario">Voltar</a>
    </form>
</div>
